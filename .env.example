# AIPIPE Token for LLM API access
AIPIPE_TOKEN=your_aipipe_token_here

# API Base URL (use AIPIPE endpoint or OpenAI-compatible endpoint)
LLM_API_URL=https://api.aipipe.io/v1/chat/completions

# Port for backend server (local development)
PORT=5000

# Node environment (development or production)
NODE_ENV=development